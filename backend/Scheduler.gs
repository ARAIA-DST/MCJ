function nearestRoute_(outlets,lat,lng){var remaining=outlets.slice(),route=[];while(remaining.length){remaining.sort(function(a,b){return haversine_(lat,lng,a.lat,a.lng)-haversine_(lat,lng,b.lat,b.lng);});var next=remaining.shift();route.push(next);lat=next.lat;lng=next.lng;}return route;}
function generateRoster_(ctx,p){var conf=config_(ctx);assert_(conf.option_fm,'OPTION_DISABLED','Opsi FM tidak aktif.');var date=date_(p.date),staff=eligibleStaff_(ctx,'fm',listIds_(p.user_ids)),outlets=ctx.table('Outlets').filter(function(o){return o.active;});assert_(outlets.length>=staff.length*6+1,'VALIDATION','Perlu minimal '+(staff.length*6+1)+' outlet untuk 6 primer per FM tanpa duplikasi harian. Seed 20 cukup untuk maksimal 3 FM.');var used={};ctx.table('Roster').filter(function(r){return r.date===date&&!r.backup;}).forEach(function(r){used[r.outlet_id]=true;});var made=[];
  staff.forEach(function(u){assert_(!ctx.table('Roster').some(function(r){return r.user_id===u.id&&r.date===date;}),'CONFLICT','Roster '+u.name+' sudah ada untuk tanggal ini.');var local=outlets.filter(function(o){return o.area===u.area;}),base=local[0]||outlets[0],available=outlets.filter(function(o){return !used[o.id];}),ordered=nearestRoute_(available,base.lat,base.lng);assert_(ordered.length>=7,'VALIDATION','Outlet tidak cukup untuk primer + backup.');var primary=ordered.slice(0,6);primary.forEach(function(o){used[o.id]=true;});var last=primary[5],backup=outlets.filter(function(o){return primary.every(function(x){return x.id!==o.id;});}).sort(function(a,b){return haversine_(last.lat,last.lng,a.lat,a.lng)-haversine_(last.lat,last.lng,b.lat,b.lng);})[0];primary.concat([backup]).forEach(function(o,i){made.push(ctx.add('Roster',{user_id:u.id,outlet_id:o.id,date:date,position:i+1,backup:i===6,status:'planned',rebook_of:'',plan_id:ctx.requestId},u.id+'-'+i));});});audit_(ctx,'roster.generate','Roster',ctx.requestId,{date:date,count:made.length});return {assignments:made.length};}
function rebookRoster_(ctx,p){var ids=listIds_(p.roster_ids),date=date_(p.date);assert_(date>=today_(),'VALIDATION','Rebooking harus hari ini atau berikutnya.');var made=[];ids.forEach(function(id){var old=entity_(ctx,'Roster',id);assert_(!old.backup&&(old.status==='missed'||old.date<today_())&&old.status!=='completed'&&old.status!=='rebooked','VALIDATION','Hanya kunjungan primer yang belum selesai.');assert_(readiness_(ctx,old.user_id),'NOT_READY','Staf belum siap.');assert_(!ctx.table('Roster').some(function(r){return r.rebook_of===old.id;}),'CONFLICT','Sudah direbooking.');var slots=ctx.table('Roster').filter(function(r){return r.user_id===old.user_id&&r.date===date&&!r.backup;});assert_(slots.length<6,'VALIDATION','Roster tujuan sudah memiliki 6 primer.');made.push(ctx.add('Roster',{user_id:old.user_id,outlet_id:old.outlet_id,date:date,position:slots.length+1,backup:false,status:'planned',rebook_of:old.id,plan_id:ctx.requestId},old.id));old.status='rebooked';ctx.put('Roster',old);});audit_(ctx,'roster.rebook','Roster',ctx.requestId,{count:made.length});return {rebooked:made.length};}
