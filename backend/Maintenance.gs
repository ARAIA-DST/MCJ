/** Owner-run, archive old operational rows to private Sheets before removing them from the hot DB. */
function archiveMonthly(){var actor={id:'system',role:'admin'};return transaction_(actor,{action:'internal.archive',requestId:'archive-'+today_(),payload:{}},function(ctx){var conf=config_(ctx),cutoff=addDays_(today_(),-conf.retention_days),tables=['MessageLog','Sessions','RateLimits','AuditLog'],archived=0;
  tables.forEach(function(t){var old=ctx.table(t).filter(function(r){return day_(r.created_at)<cutoff&&(t!=='MessageLog'||['sent','delivered','failed','cancelled'].indexOf(r.status)!==-1);});if(!old.length)return;var folder=folderByName_(rootFolder_(),'_archives'),fileName=t+'_'+today_()+'.csv',files=folder.getFilesByName(fileName);if(!files.hasNext())folder.createFile(fileName,csv_(old,BASE_COLUMNS_.concat(COLUMNS_[t])),MimeType.CSV);ctx.erase(t,old.map(function(r){return r.id;}));archived+=old.length;});
  var requestCutoff=addDays_(today_(),-conf.request_retention_days),stale=ctx.table('Requests').filter(function(r){return r.status==='done'&&day_(r.created_at)<requestCutoff;});ctx.erase('Requests',stale.map(function(r){return r.id;}));return {archived:archived,requestsPurged:stale.length,cutoff:cutoff,notice:'Archive files are private and must follow the same erasure/retention policy. Core pilot KPI tables retained; archive them after final reconciled report.'};});}
