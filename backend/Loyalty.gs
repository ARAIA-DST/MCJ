function customerAllowed_(ctx,c){return MANAGERS_.indexOf(ctx.actor.role)!==-1||c.created_by===ctx.actor.id&&outletAccess_(ctx,c.workshop_id);}
function pointsBalance_(ctx,id){var today=today_();return Math.max(0,ctx.table('PointsLedger').filter(function(r){return r.customer_id===id&&(!r.expires_at||r.expires_at.slice(0,10)>=today);}).reduce(function(n,r){return n+r.points;},0));}
function tier_(points,conf){return points>=conf.tier_platinum?'Platinum':points>=conf.tier_gold?'Gold':'Silver';}
function consent_(ctx,c,optin,source,evidence){var conf=config_(ctx);c.wa_opt_in=optin;c.consent_at=now_();c.consent_source=source;ctx.add('Consents',{customer_id:c.id,opt_in:optin,timestamp:now_(),source:source,actor_id:ctx.actor.id,text_version:conf.consent_text_version,evidence:str_(evidence,1000,true),number_hash:digest_(c.phone)},c.id+':'+Object.keys(ctx.changes.Consents||{}).length);audit_(ctx,optin?'consent.optin':'consent.optout','Customers',c.id,{source:source,text_version:conf.consent_text_version});}
function nextService_(ctx,last,kind,odometer){var conf=config_(ctx),calendar=addMonths_(last,conf.service_intervals[kind]||6),km=conf.service_odometer_intervals[kind]||conf.odometer_interval_km,projected=conf.projected_km_per_day>0?addDays_(last,Math.ceil(km/conf.projected_km_per_day)):calendar;return {date:projected<calendar?projected:calendar,odometer:odometer!==''&&odometer!==undefined?Number(odometer)+km:''};}
function upsertCustomer_(ctx,p){var ph=phone_(p.phone),plate=plate_(p.plate),workshop=id_(p.workshop_id);assert_(outletAccess_(ctx,workshop),'FORBIDDEN','Bengkel tidak sesuai penugasan.');assert_(ctx.table('Workshops').some(function(w){return w.active&&w.outlet_id===workshop;}),'VALIDATION','Pilih workshop aktif.');var rows=ctx.table('Customers'),c=p.id?entity_(ctx,'Customers',id_(p.id)):rows.find(function(r){return !r.deleted&&r.phone===ph&&r.plate===plate;});if(c)assert_(customerAllowed_(ctx,c),'FORBIDDEN','Pelanggan sudah terdaftar; hubungi supervisor untuk pembaruan.');if(!c)c=ctx.add('Customers',{cycle_id:uuid_(),reminder_attempts:0,deleted:false},ph+plate);assert_(!rows.some(function(r){return !r.deleted&&r.id!==c.id&&r.phone===ph&&r.plate===plate;}),'DUPLICATE','Nomor + plat telah terdaftar.');
  var optin=bool_(p.wa_opt_in),source=one_(p.consent_source,['spg','fm','workshop']),last=date_(p.last_service_date),kind=one_(p.service_type,['general','brake_check','shock_absorber']);assert_(last<=today_(),'VALIDATION','Tanggal servis terakhir tidak boleh di masa depan.');if(optin)assert_(p.consent_confirmed===true,'CONSENT_REQUIRED','Centang persetujuan WhatsApp dari pelanggan.');var changed=c.wa_opt_in!==optin||c.phone!==ph||!c.consent_at;
  Object.assign(c,{name:str_(p.name,100,true),phone:ph,plate:plate,brand:str_(p.brand,100,true),model:str_(p.model,100,true),year:num_(p.year,1950,Number(today_().slice(0,4))+1),birthday:p.birthday?date_(p.birthday):'',workshop_id:workshop,last_service_date:last,odometer:p.odometer===''||p.odometer===undefined?'':num_(p.odometer,0,3000000),service_type:kind,next_service_date:addMonths_(last,config_(ctx).service_intervals[kind]||6)});
  var due=nextService_(ctx,last,kind,c.odometer);c.next_service_date=due.date;c.next_service_odometer=due.odometer;if(changed)consent_(ctx,c,optin,source,p.consent_evidence||'Checkbox confirmed in field app: '+config_(ctx).consent_text);ctx.put('Customers',c);audit_(ctx,'customer.upsert','Customers',c.id,{workshop:workshop});return {id:c.id,label:'Pelanggan •••'+ph.slice(-4),wa_opt_in:c.wa_opt_in,next_service_date:c.next_service_date};
