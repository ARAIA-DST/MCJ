function deleteCustomer_(ctx,p){var c=entity_(ctx,'Customers',id_(p.customer_id));var old=c.id;cancelPendingMessages_(ctx,old);['Consents','PointsLedger','Vouchers','Redemptions','ServiceEvents','MessageLog'].forEach(function(t){ctx.table(t).filter(function(r){return r.customer_id===old;}).forEach(function(r){r.customer_id='erased';if(t==='Consents'){r.evidence='Erased by data subject request';r.number_hash='';}if(t==='MessageLog'){r.variables={};r.manual_url='';r.error='';}ctx.put(t,r);});});ctx.table('Surveys').filter(function(s){return s.customer_id===old;}).forEach(function(s){s.customer_id='';ctx.put('Surveys',s);});ctx.table('LeadContacts').filter(function(r){return r.phone===c.phone;}).forEach(function(r){ctx.erase('LeadContacts',[r.id]);});ctx.table('Requests').filter(function(r){return r.status==='done'&&(r.response_json.indexOf(old)!==-1||r.response_json.indexOf(c.phone)!==-1||r.response_json.indexOf(c.phone.slice(1))!==-1);}).forEach(function(r){r.response_json=JSON.stringify({redacted:true,reason:'data subject erasure'});ctx.put('Requests',r);});ctx.erase('Customers',[old]);var job=ctx.add('PrivacyJobs',{customer_id:'erased',operation:'delete',status:'completed',requested_by:ctx.actor.id,completed_at:now_()},old);audit_(ctx,'customer.delete','PrivacyJobs',job.id,{erased:true});return {deleted:true,notice:'Customer registry and linked PII erased. Independent LeadContacts require separate retention/erasure. Drive evidence/exports/backups managed by owner.'};}
