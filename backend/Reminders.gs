  transaction_({id:'system',role:'admin'},{action:'internal.maintenance',requestId:'maintenance-'+today_()+'-'+Math.floor(Date.now()/900000),payload:{}},function(ctx){var count=0;ctx.table('MessageLog').filter(function(m){return m.status==='sending'&&Date.now()-Date.parse(m.last_attempt_at)>10*60000;}).forEach(function(m){m.status='unknown';m.error='Interrupted provider request; verify in provider dashboard.';ctx.put('MessageLog',m);count++;});ctx.table('Vouchers').filter(function(v){return ['issued','sent','delivered'].indexOf(v.status)!==-1&&Date.parse(v.expires_at)<Date.now();}).forEach(function(v){v.status='expired';ctx.put('Vouchers',v);});return {ambiguous:count};});
}
function installTriggers(){var lock=LockService.getScriptLock();lock.waitLock(15000);try{ScriptApp.getProjectTriggers().filter(function(t){return ['runDailyReminders','runBackgroundJobs'].indexOf(t.getHandlerFunction())!==-1;}).forEach(function(t){ScriptApp.deleteTrigger(t);});ScriptApp.newTrigger('runDailyReminders').timeBased().atHour(9).nearMinute(0).everyDays(1).inTimezone(TZ_).create();ScriptApp.newTrigger('runBackgroundJobs').timeBased().everyMinutes(15).create();return {installed:2,timezone:TZ_,daily:'around 09:00 (Google time triggers are approximate)',continuation:'every 15 minutes'};}finally{lock.releaseLock();}}
