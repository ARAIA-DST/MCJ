function publicConfig_(conf){var keys=['option_spg','option_fm','pilot_start','fm_target','fm_threshold','survey_target','surveys_per_workshop_week','consent_text','consent_text_version','wa_provider','tier_gold','tier_platinum'];var out={};keys.forEach(function(k){out[k]=conf[k];});return out;}
function bootstrap_(ctx){var u=ctx.actor,manager=MANAGERS_.indexOf(u.role)!==-1,client=u.role==='client_viewer',assign=ctx.table('Roster').concat(ctx.table('Rotation')).filter(function(r){return manager||r.user_id===u.id;}),assigned=new Set(assign.map(function(r){return r.outlet_id;}));(u.workshop_ids||[]).forEach(function(id){assigned.add(id);});var outlets=ctx.table('Outlets').filter(function(o){return o.active&&(manager||client||assigned.has(o.id));}).map(function(o){var copy=Object.assign({},o);return copy;});return {user:cleanPublicUser_(u),config:publicConfig_(config_(ctx)),outlets:outlets,readiness:client||manager?true:readiness_(ctx,u.id),date:today_(),training:trainingList_(ctx),customers:['spg','fm'].indexOf(u.role)!==-1?listCustomers_(ctx):[]};}
function todayData_(ctx,p){var date=p.date?date_(p.date):today_(),u=ctx.actor,manager=MANAGERS_.indexOf(u.role)!==-1;if(u.role==='client_viewer')return {date:date,tasks:[],visits:[],exceptions:[],planned:0,completed:0};var assignments=ctx.table(u.role==='spg'?'Rotation':'Roster').filter(function(r){return (manager||r.user_id===u.id)&&(r.date?r.date===date:(date>=r.week_start&&date<=r.week_end));});var visits=ctx.table('Visits').filter(function(v){return v.date===date&&(manager||v.user_id===u.id);}),tasks=assignments.map(function(r){var o=entity_(ctx,'Outlets',r.outlet_id),v=visits.find(function(v){return v.assignment_id===r.id;});return Object.assign({},r,{outlet:o,visit_id:v?v.id:'',visit_status:v?v.status:''});});return {date:date,tasks:tasks,visits:visits,exceptions:ctx.table('Exceptions').filter(function(e){return visits.some(function(v){return v.id===e.visit_id;});}),planned:tasks.filter(function(t){return !t.backup;}).length,completed:visits.filter(function(v){return v.status==='approved'||v.status==='client-approved exception';}).length};}
function trainingList_(ctx){var manager=MANAGERS_.indexOf(ctx.actor.role)!==-1;return {courses:ctx.table('Training').filter(function(t){return manager||t.active&&t.approved;}).map(function(t){return Object.assign({},t,{questions:t.questions.map(function(q){return {question:q.question,options:q.options};})});}),results:ctx.table('QuizResults').filter(function(r){return manager||r.user_id===ctx.actor.id;})};}
function saveTraining_(ctx,p){assert_(Array.isArray(p.questions)&&p.questions.length>=5&&p.questions.length<=30,'VALIDATION','Materi perlu 5–30 pertanyaan.');var questions=p.questions.map(function(q){assert_(Array.isArray(q.options)&&q.options.length>=2&&q.options.length<=6,'VALIDATION','Pilihan quiz 2–6.');return {question:str_(q.question,500,true),options:q.options.map(function(s){return str_(s,300,true);}),correct:num_(q.correct,0,q.options.length-1)};});var t=p.id?entity_(ctx,'Training',id_(p.id)):ctx.add('Training',{},'course');Object.assign(t,{name:str_(p.name,200,true),questions:questions,pass_score:num_(p.pass_score,80,100),active:bool_(p.active),approved:bool_(p.approved),version:uuid_()});ctx.put('Training',t);audit_(ctx,'training.save','Training',t.id,{version:t.version,approved:t.approved});return {id:t.id,version:t.version};}
function saveConfig_(ctx,p){var updates=p.values;assert_(updates&&typeof updates==='object'&&!Array.isArray(updates),'VALIDATION','values diperlukan.');Object.keys(updates).forEach(function(k){assert_(Object.prototype.hasOwnProperty.call(DEFAULT_CONFIG_,k),'VALIDATION','Key konfigurasi tidak diizinkan: '+k);var v=updates[k];assert_(typeof v===typeof DEFAULT_CONFIG_[k]&&JSON.stringify(v).length<5000,'VALIDATION','Tipe konfigurasi tidak sesuai.');
    if(k==='wa_provider')one_(v,['wa_link','fonnte','meta_cloud']);if(['quiet_start','quiet_end'].indexOf(k)!==-1)num_(v,0,23);if(['frequency_per_7days','sla_working_days','reminder_batch','retention_days','request_retention_days','points_expiry_days'].indexOf(k)!==-1)num_(v,1,3650);if(k==='request_retention_days')assert_(v>=60,'VALIDATION','Retensi request minimal 60 hari.');if(k==='pilot_start')date_(v);if(k==='working_days'){assert_(Array.isArray(v)&&v.length&&v.every(function(d){return Number.isInteger(d)&&d>=0&&d<=6;}),'VALIDATION','working_days tidak valid.');}if(k==='holidays'){assert_(Array.isArray(v),'VALIDATION','holidays array diperlukan.');v.forEach(date_);}if(k==='service_odometer_intervals')assert_(Object.keys(v).every(function(s){return ['general','brake_check','shock_absorber'].indexOf(s)!==-1&&Number.isFinite(v[s])&&v[s]>=1000&&v[s]<=100000;}),'VALIDATION','Interval odometer tidak valid.');if(k==='projected_km_per_day')num_(v,0,1000);if(k==='service_intervals'){assert_(Object.keys(v).every(function(s){return ['general','brake_check','shock_absorber'].indexOf(s)!==-1&&Number.isInteger(v[s])&&v[s]>=1&&v[s]<=24;}),'VALIDATION','Interval servis 1–24 bulan.');}if(k==='reminder_stages')assert_(JSON.stringify(v)==='[-14,0,14]','VALIDATION','Tahapan pilot harus T-14/T0/T+14.');if(['fm_target','fm_threshold','survey_target','pilot_weeks'].indexOf(k)!==-1)assert_(v===DEFAULT_CONFIG_[k],'VALIDATION','Definisi target pilot tidak dapat diubah.');
    var row=ctx.table('Config').find(function(r){return r.key===k;})||ctx.add('Config',{key:k},k);row.value=JSON.stringify(v);ctx.put('Config',row);
  });var result=config_(ctx);assert_(result.quiet_start<result.quiet_end&&result.max_send_attempts===3,'VALIDATION','Quiet hours harus urut; maksimal 3 attempts.');audit_(ctx,'config.save','Config',ctx.requestId,{keys:Object.keys(updates)});return result;}
function adminList_(ctx,p){var table=one_(p.table,['Users','Outlets','Workshops','Rotation','Roster','Visits','VisitPhotos','Surveys','SurveyAnswers','Exceptions','Leads','Training','QuizResults','Config','AuditLog']);if(ctx.actor.role==='supervisor')assert_(['Users','Outlets','Workshops','Rotation','Roster','Visits','VisitPhotos','Surveys','SurveyAnswers','Exceptions','Leads','QuizResults'].indexOf(table)!==-1,'FORBIDDEN','Tabel admin.');var rows=ctx.table(table);if(table==='Users')rows=rows.map(function(u){return Object.assign(cleanPublicUser_(u),{active:u.active,workshop_ids:u.workshop_ids});});if(table==='Training')rows=trainingList_(ctx).courses;return {rows:rows};}
